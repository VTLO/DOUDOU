{
  "name": "shopify-ia",
  "version": "0.1.0",
  "description": "Shopify ia — AI-powered toolkit for Shopify store management using Claude",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "shopify-ia": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && npm run build --prefix ui",
    "dev": "concurrently \"tsx watch src/server.ts\" \"npm run dev --prefix ui\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:ui": "npm run dev --prefix ui",
    "start": "node dist/server.js",
    "cli": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "concurrently": "^8.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "ora": "^8.0.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
